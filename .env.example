NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://localhost:3000
# Puertos publicados por el Compose unificado.
DENTALRISK_PORT=3000
AGENT_API_PORT=8000
# Credenciales internas del stack. Reemplaza todos los valores CHANGE_ME.
POSTGRES_OWNER_PASSWORD=CHANGE_ME_OWNER_24_CHARS_MIN
APP_DB_PASSWORD=CHANGE_ME_APP_24_CHARS_MIN
BACKUP_DB_PASSWORD=CHANGE_ME_BACKUP_24_CHARS_MIN
AGENT_DB_PASSWORD=CHANGE_ME_AGENT_DB_24_CHARS_MIN
AGENT_SECRET_KEY=CHANGE_ME_AGENT_SECRET_32_CHARS_MINIMUM
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_24_CHARS_MIN
MINIO_BUCKET=dentalrisk-profiles
# Solo se usa al ejecutar la API fuera de Docker.
DATABASE_URL=postgresql://dentalrisk_app:CHANGE_ME_APP_24_CHARS_MIN@127.0.0.1:5432/dentalrisk
CLINIC_TIMEZONE=America/Tijuana
RFID_DEBOUNCE_MS=2000
SESSION_HOURS=8
# Optional AI chat provider. Must implement the OpenAI-compatible chat completions API.
# Use HTTPS for cloud providers. A local HTTP endpoint is allowed only on localhost.
AGENT_CHAT_BASE_URL=
AGENT_CHAT_MODEL=
AGENT_CHAT_API_KEY=
# Cuenta inicial. En arranques posteriores no cambia cuentas existentes.
ADMIN_EMAIL=admin@dentalrisk.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_12_CHARS_MIN
# Production: separate mounted destination, encrypted backups; 64 hexadecimal characters.
BACKUP_DIR=
BACKUP_KEY=
BACKUP_RETENTION_DAYS=30
