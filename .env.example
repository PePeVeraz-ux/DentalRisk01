NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://localhost:3000
# PostgreSQL is required. Set your own credentials before starting the API.
DATABASE_URL=
CLINIC_TIMEZONE=America/Tijuana
RFID_DEBOUNCE_MS=2000
SESSION_HOURS=8
# Optional AI chat provider. Must implement the OpenAI-compatible chat completions API.
# Use HTTPS for cloud providers. A local HTTP endpoint is allowed only on localhost.
AGENT_CHAT_BASE_URL=
AGENT_CHAT_MODEL=
AGENT_CHAT_API_KEY=
# Set before running npm run bootstrap; never commit actual credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production: separate mounted destination, encrypted backups; 64 hexadecimal characters.
BACKUP_DIR=
BACKUP_KEY=
BACKUP_RETENTION_DAYS=30
