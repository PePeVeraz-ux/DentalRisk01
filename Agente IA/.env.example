# Generate an actual .env with: python scripts/prepare_env.py
DATABASE_URL=postgresql+psycopg://dentalrisk_agent:configure-after-merge@127.0.0.1:5432/dentalrisk
CLINICAL_CONNECTOR_ENABLED=true
SECRET_KEY=generate-with-prepare-env
ENVIRONMENT=development
MINIO_ENDPOINT=http://127.0.0.1:9100
MINIO_ACCESS_KEY=generate-with-prepare-env
MINIO_SECRET_KEY=generate-with-prepare-env
MINIO_BUCKET=dentalrisk-profiles
# POSTGRES_PASSWORD solo es necesario para el Compose aislado de demostración.
POSTGRES_PASSWORD=generate-with-prepare-env
AI_MODEL=qwen2.5:7b
CLINIC_TIMEZONE=America/Tijuana
# Optional, set by scripts/configure_esp.py after authenticating the owner:
# ESP_BASE_URL=http://IP_ACTUAL_DEL_ESP
# ESP_AGENT_OWNER_ID=UUID_DEL_DUENO
# ESP_AGENT_KEY_HASH=SHA256_DE_LA_CREDENCIAL_DEL_ESP
# ESP_API_BIND_ADDRESS=IP_LAN_DE_ESTA_COMPUTADORA
# ESP_API_PORT=8000
